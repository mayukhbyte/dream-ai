# Database Configuration
POSTGRES_USER=dreamfood
POSTGRES_PASSWORD=dreamfood123
POSTGRES_DB=dreamfood

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Port for API
PORT=5000

# Optional: Google Maps API Key (for future use)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: AWS S3 for file uploads (for future use)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_BUCKET_NAME=your_bucket_name
# AWS_REGION=your_aws_region

# Firebase Client Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dream-food-delivery.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dream-food-delivery
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dream-food-delivery.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Admin SDK Configuration (API Service Account JSON)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}